{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramypulse.local/schemas/business-comment-annotation/0.1.0",
  "title": "RamyPulse Business Comment Annotation",
  "description": "Contrat de sortie controle pour un SLM d'annotation de commentaires business multilingues.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "is_exploitable",
    "non_exploitable_reason",
    "business_relevance",
    "language",
    "entities",
    "sentiment",
    "intents",
    "aspects",
    "alerts",
    "actionability"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "is_exploitable": {
      "type": "boolean"
    },
    "non_exploitable_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "hors_sujet",
        "spam",
        "texte_insuffisant",
        "incomprehensible",
        "langue_non_supportee",
        "bruit_technique",
        "ambiguite_majeure"
      ]
    },
    "business_relevance": {
      "type": "string",
      "enum": [
        "directe",
        "indirecte",
        "aucune"
      ]
    },
    "language": {
      "$ref": "#/$defs/language"
    },
    "entities": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "sentiment": {
      "$ref": "#/$defs/overallSentiment"
    },
    "intents": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "avis",
          "plainte",
          "eloge",
          "question",
          "demande_information",
          "demande_aide",
          "suggestion",
          "recommandation",
          "comparaison",
          "intention_achat",
          "partage_experience",
          "signalement_incident",
          "appel_action",
          "promotion_spam",
          "tag_mention",
          "autre"
        ]
      }
    },
    "aspects": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/aspect"
      }
    },
    "alerts": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/alert"
      }
    },
    "actionability": {
      "$ref": "#/$defs/actionability"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "is_exploitable": {
            "const": true
          }
        },
        "required": [
          "is_exploitable"
        ]
      },
      "then": {
        "properties": {
          "non_exploitable_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "is_exploitable": {
            "const": false
          }
        },
        "required": [
          "is_exploitable"
        ]
      },
      "then": {
        "properties": {
          "non_exploitable_reason": {
            "type": "string"
          },
          "aspects": {
            "maxItems": 0
          },
          "alerts": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "start",
        "end"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dominant",
        "detected",
        "code_switching",
        "scripts"
      ],
      "properties": {
        "dominant": {
          "type": "string",
          "enum": [
            "darija_arabe",
            "darija_arabizi",
            "arabe_msa",
            "francais",
            "anglais",
            "tamazight_latin",
            "tamazight_tifinagh",
            "mixte",
            "autre"
          ]
        },
        "detected": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "darija",
              "arabe_msa",
              "francais",
              "anglais",
              "tamazight",
              "autre"
            ]
          }
        },
        "code_switching": {
          "type": "boolean"
        },
        "scripts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "arabe",
              "latin",
              "tifinagh",
              "chiffres",
              "autre"
            ]
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "mention",
        "start",
        "end",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ent_[0-9]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "marque",
            "organisation",
            "produit",
            "service",
            "personne",
            "lieu",
            "concurrent",
            "campagne",
            "politique_publique",
            "autre"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mention": {
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "texte",
            "contexte"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "texte"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "mention": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "integer"
              },
              "end": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "contexte"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "mention": {
                "type": "null"
              },
              "start": {
                "type": "null"
              },
              "end": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "overallSentiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "intensity",
        "emotion",
        "sarcasm",
        "target_entity_ids",
        "evidence"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/sentimentLabel"
        },
        "intensity": {
          "$ref": "#/$defs/intensity"
        },
        "emotion": {
          "type": "string",
          "enum": [
            "satisfaction",
            "admiration",
            "joie",
            "confiance",
            "deception",
            "frustration",
            "colere",
            "inquietude",
            "peur",
            "tristesse",
            "degout",
            "surprise",
            "aucune",
            "autre"
          ]
        },
        "sarcasm": {
          "type": "boolean"
        },
        "target_entity_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ent_[0-9]+$"
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "attribute",
        "target_entity_id",
        "sentiment",
        "intensity",
        "implicit",
        "evidence"
      ],
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "produit_service",
            "prix_valeur",
            "disponibilite_acces",
            "experience_client",
            "service_client_sav",
            "livraison_logistique",
            "digital_technologie",
            "communication_information",
            "confiance_reputation",
            "operations_processus",
            "emploi_management",
            "securite_conformite",
            "ethique_impact",
            "marche_innovation",
            "infrastructure_service_public"
          ]
        },
        "attribute": {
          "type": "string"
        },
        "target_entity_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^ent_[0-9]+$"
        },
        "sentiment": {
          "$ref": "#/$defs/sentimentLabel"
        },
        "intensity": {
          "$ref": "#/$defs/intensity"
        },
        "implicit": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "family": {
                "const": "produit_service"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "qualite_generale",
                  "performance",
                  "fiabilite",
                  "durabilite",
                  "fonctionnalite",
                  "design",
                  "gout",
                  "odeur",
                  "texture",
                  "fraicheur",
                  "emballage",
                  "quantite",
                  "hygiene",
                  "securite_produit",
                  "conformite_description"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "prix_valeur"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "prix",
                  "abordabilite",
                  "rapport_qualite_prix",
                  "promotion",
                  "transparence_prix",
                  "facturation"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "disponibilite_acces"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "stock",
                  "rupture",
                  "couverture_geographique",
                  "accessibilite",
                  "horaires",
                  "canal_achat"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "experience_client"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "satisfaction_globale",
                  "facilite",
                  "attente",
                  "accueil",
                  "comportement_personnel",
                  "personnalisation",
                  "fidelite"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "service_client_sav"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "reactivite",
                  "resolution",
                  "remboursement",
                  "garantie",
                  "traitement_reclamation",
                  "professionnalisme"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "livraison_logistique"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "delai_livraison",
                  "etat_reception",
                  "suivi_commande",
                  "distribution",
                  "approvisionnement"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "digital_technologie"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "application",
                  "site_web",
                  "ergonomie",
                  "bug",
                  "connexion_reseau",
                  "paiement",
                  "securite_donnees"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "communication_information"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "clarte",
                  "exactitude",
                  "transparence",
                  "publicite",
                  "promesse",
                  "information_manquante"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "confiance_reputation"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "confiance",
                  "credibilite",
                  "image_marque",
                  "authenticite",
                  "recommandation",
                  "comparaison_concurrent"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "operations_processus"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "efficacite",
                  "delai",
                  "procedure",
                  "coherence",
                  "continuite_service",
                  "capacite"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "emploi_management"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "recrutement",
                  "salaire",
                  "conditions_travail",
                  "management",
                  "formation",
                  "equite_interne"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "securite_conformite"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "securite",
                  "sante",
                  "hygiene",
                  "conformite_legale",
                  "fraude",
                  "confidentialite"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "ethique_impact"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "equite",
                  "discrimination",
                  "corruption",
                  "responsabilite_sociale",
                  "environnement",
                  "impact_local"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "marche_innovation"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "innovation",
                  "positionnement",
                  "concurrence",
                  "production_locale",
                  "import_export",
                  "tendance"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "infrastructure_service_public"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "attribute": {
                "enum": [
                  "infrastructure",
                  "transport",
                  "eau_energie",
                  "sante_publique",
                  "education",
                  "administration",
                  "couverture_territoriale"
                ]
              }
            }
          }
        }
      ]
    },
    "sentimentLabel": {
      "type": "string",
      "enum": [
        "negatif",
        "neutre",
        "positif",
        "mixte"
      ]
    },
    "intensity": {
      "type": "string",
      "enum": [
        "faible",
        "moyenne",
        "forte"
      ]
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "severity",
        "target_entity_id",
        "evidence"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "qualite_produit",
            "securite_sante",
            "fraude_arnaque",
            "juridique_conformite",
            "rupture_service",
            "rupture_stock",
            "reputation_virale",
            "donnees_confidentialite",
            "harcelement_discrimination"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "faible",
            "moyenne",
            "elevee",
            "critique"
          ]
        },
        "target_entity_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^ent_[0-9]+$"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "actionability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionable",
        "queue",
        "priority"
      ],
      "properties": {
        "actionable": {
          "type": "boolean"
        },
        "queue": {
          "type": "string",
          "enum": [
            "produit",
            "pricing",
            "service_client",
            "ventes",
            "operations",
            "logistique",
            "digital",
            "communication",
            "rh",
            "juridique_conformite",
            "securite_qualite",
            "direction",
            "aucune"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "faible",
            "moyenne",
            "elevee",
            "critique"
          ]
        }
      }
    }
  }
}
